{
  "name": "dangling_edge_without_id",
  "description": "A removed edge with no id reports value null.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "from": "a",
        "to": "b"
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/0/to"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": []
  },
  "expected_changes": [
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/0",
      "value": null
    }
  ]
}
