{
  "name": "edge_to_group_id",
  "description": "An edge may only point at nodes. A group id or an edge id does not count.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "a",
        "to": "g1",
        "kind": "flow"
      },
      {
        "id": "e2",
        "from": "e1",
        "to": "a",
        "kind": "flow"
      }
    ],
    "groups": [
      {
        "id": "g1",
        "name": "Group",
        "members": [
          "a"
        ]
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/0/to"
    },
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/1/from"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [],
    "groups": [
      {
        "id": "g1",
        "name": "Group",
        "members": [
          "a"
        ]
      }
    ]
  },
  "expected_changes": [
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/0",
      "value": "e1"
    },
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/1",
      "value": "e2"
    }
  ]
}
