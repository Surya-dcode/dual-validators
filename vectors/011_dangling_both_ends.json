{
  "name": "dangling_both_ends",
  "description": "Both ends are missing: two issues, one removal.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "x",
        "to": "y",
        "kind": "flow"
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_DANGLING_EDGE",
