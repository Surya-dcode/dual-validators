    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/0/to"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": []
