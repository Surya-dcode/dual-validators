{
  "name": "bad_number_overflow_literals",
  "description": "1e400 and a 401-digit integer are valid JSON text. JavaScript parses both as Infinity; Python parses the first as inf and the second as an exact int, which must still be rejected.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 1e400,
        "y": ,
        "w": 10,
        "h": -1e400
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_BAD_NUMBER",
      "severity": "error",
      "path": "/nodes/0/h"
    },
    {
      "code": "E_BAD_NUMBER",
      "severity": "error",
      "path": "/nodes/0/x"
    },
    {
      "code": "E_BAD_NUMBER",
      "severity": "error",
      "path": "/nodes/0/y"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 1e400,
        "y": ,
        "w": 10,
        "h": -1e400
      }
    ]
  },
  "expected_changes": []
}
