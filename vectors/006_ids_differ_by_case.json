{
  "name": "ids_differ_by_case",
  "description": "\"node\", \"Node\" and \"NODE\" are three different ids, and a reference must match case exactly.",
  "input": {
    "nodes": [
      {
        "id": "node",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "Node",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "NODE",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "node",
        "to": "NODE",
        "kind": "flow"
      },
      {
        "id": "e2",
        "from": "Node",
        "to": "nODE",
        "kind": "flow"
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/1/to"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "node",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "Node",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "NODE",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "node",
        "to": "NODE",
        "kind": "flow"
      }
    ]
  },
  "expected_changes": [
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/1",
      "value": "e2"
    }
  ]
}
