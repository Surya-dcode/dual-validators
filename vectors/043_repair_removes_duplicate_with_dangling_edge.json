{
  "name": "repair_removes_duplicate_with_dangling_edge",
  "description": "The second e1 is both a duplicate id and dangling. Removing the dangling edge also clears the duplicate.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "b",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "a",
        "to": "b",
        "kind": "flow"
      },
      {
        "id": "e1",
        "from": "a",
        "to": "c",
        "kind": "flow"
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_DUP_ID",
      "severity": "error",
      "path": "/edges/1/id"
    },
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/1/to"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      },
      {
        "id": "b",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "a",
        "to": "b",
        "kind": "flow"
      }
    ]
  },
  "expected_changes": [
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/1",
      "value": "e1"
    }
  ]
}
