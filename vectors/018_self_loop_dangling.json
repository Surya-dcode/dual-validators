{
  "name": "self_loop_dangling",
  "description": "A self-loop on a missing node is reported as dangling at both ends and as a self-loop; repair removes it.",
  "input": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "zz",
        "to": "zz",
        "kind": "flow"
      }
    ]
  },
  "expected_issues": [
    {
      "code": "E_SELF_LOOP",
      "severity": "error",
      "path": "/edges/0"
    },
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/0/from"
    },
    {
      "code": "E_DANGLING_EDGE",
      "severity": "error",
      "path": "/edges/0/to"
    }
  ],
  "expected_repaired": {
    "nodes": [
      {
        "id": "a",
        "label": "Node",
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 10
      }
    ],
    "edges": []
  },
  "expected_changes": [
    {
      "code": "E_DANGLING_EDGE",
      "action": "remove_edge",
      "path": "/edges/0",
      "value": "e1"
    }
  ]
}
